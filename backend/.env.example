# ====================================================================
# Lion Delivery Platform — Environment Configuration Template
# NOTE: Never commit real credentials or production secrets.
# All values below are safe defaults and placeholders for local development.
# ====================================================================

# 1. Server Configuration
PORT=4050
NODE_ENV=development
DASHBOARD_URL=http://localhost:5173

# 2. MySQL Database (MySQL 8.0+)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=mysql
DB_NAME=lion_delivery

# 3. Redis Memory Store
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://127.0.0.1:6379

# 4. Authentication & Security (JWT)
JWT_SECRET=lion_demo_secret_2026_super_secure_pbkdf2_jwt_signing

# 5. WhatsApp Integration Boundary (G-053, G-061)
# WHATSAPP_MODE:
#   - MOCK: Explicit local simulated boundary. Webhook and simulator routes work offline.
#   - LIVE: Requires valid Meta Cloud API credentials. Startup fails fast if credentials are missing.
WHATSAPP_MODE=MOCK
WHATSAPP_PHONE_NUMBER_ID=demo_phone_number_id_placeholder
WHATSAPP_ACCESS_TOKEN=demo_whatsapp_access_token_placeholder
WHATSAPP_VERIFY_TOKEN=lion_demo_verify_token_2026
WHATSAPP_APP_SECRET=demo_whatsapp_app_secret_placeholder

# 6. Media Processing Boundaries (Audio Transcription & Vision - G-054, G-062)
# MEDIA_MODE:
#   - FIXTURE: Explicit local demo mode using deterministic mock audio transcripts and vision labels.
#   - LIVE: Fails closed unless valid cloud AI credentials are provided. Never falls back to canned responses.
MEDIA_MODE=FIXTURE

# TRANSCRIPTION_PROVIDER:
#   - FIXTURE: Deterministic local speech-to-text demo boundary.
#   - WHISPER: Real OpenAI Whisper speech-to-text API (requires OPENAI_API_KEY).
TRANSCRIPTION_PROVIDER=FIXTURE

# VISION_PROVIDER:
#   - FIXTURE: Deterministic local food image recognition demo boundary.
#   - VISION_API: Real OpenAI GPT-4o Vision API (requires OPENAI_API_KEY).
VISION_PROVIDER=FIXTURE

# Optional OpenAI API Key for LIVE transcription and vision analysis
OPENAI_API_KEY=your_openai_api_key_placeholder

# 7. AI Conversational Engine (G-020, G-021)
# AI_PROVIDER:
#   - gemini: Google Gemini 3.8 Flash live conversational engine with controlled autonomous tool calling (production default).
#   - smart_nlu: Local deterministic test-only fallback; production is Gemini-only.
AI_PROVIDER=gemini
AI_API_KEY=

# Explicit production routing graph (Gemini-only)
AI_ROUTING_MODE=STABLE_ONLY
AI_STABLE_PROVIDER=gemini
AI_CANDIDATE_PROVIDER=gemini
AI_CANARY_PERCENTAGE=0

# Google Gemini API Configuration (Required when AI_PROVIDER=gemini)
# Official documentation: https://ai.google.dev/gemini-api/docs/models/gemini-3.8-flash
GEMINI_API_KEY=demo_gemini_api_key_placeholder
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MAX_OUTPUT_TOKENS=600
